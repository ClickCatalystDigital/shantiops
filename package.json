{
  "name": "sb-ops",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "node scripts/check-syntax.mjs",
    "postinstall": "node scripts/copy-pdf-worker.js",
    "cf:build": "node scripts/gen-api-routes.mjs && node scripts/gen-migrate-fingerprint.mjs && SB_TARGET=workers NEXT_PRIVATE_STANDALONE=true next build && node scripts/demo/strip-route-manifests.mjs && node scripts/demo/patch-yoga.mjs && opennextjs-cloudflare build --skipNextBuild --dangerouslyUseUnsupportedNextVersion && node scripts/demo/relative-wasm-imports.mjs && node scripts/demo/strip-client-traces.mjs && rm -rf .next",
    "cf:preview": "npm run cf:build && opennextjs-cloudflare preview",
    "cf:deploy": "npm run cf:build && opennextjs-cloudflare deploy",
    "prebuild": "node scripts/gen-api-routes.mjs && node scripts/gen-migrate-fingerprint.mjs",
    "predev": "node scripts/gen-api-routes.mjs && node scripts/gen-migrate-fingerprint.mjs",
    "check": "npm run lint && node scripts/check-all.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1102.0",
    "@libsql/client": "^0.17.4",
    "@react-pdf/renderer": "^4.5.1",
    "@tailwindcss/postcss": "^4.3.2",
    "bcryptjs": "^2.4.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^1.23.0",
    "mathjs": "^15.2.0",
    "next": "15.5.27",
    "nodemailer": "^10.0.12",
    "otplib": "^12.0.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.6.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-resizable-panels": "^4.12.3",
    "recharts": "^3.8.0",
    "shadcn": "^4.13.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.2",
    "tw-animate-css": "^1.4.0",
    "undici": "^7.28.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@babel/parser": "^7.29.9",
    "@opennextjs/cloudflare": "^1.20.10",
    "postcss": "^8.5.16",
    "wrangler": "^4.149.0"
  }
}
