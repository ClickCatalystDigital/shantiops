# Leave TURSO_URL blank to use a local SQLite file (./shanti-ops-local.db) for dev.
# Set both to point at a Turso database for production / to share data across deployments.
TURSO_URL=
TURSO_AUTH_TOKEN=

# JWT signing secret — set a long random string in production
SESSION_SECRET=change-this-in-production

# Branding shown in the nav bar / login screen / <title>
BRAND_PREFIX=SB
BRAND_NAME=Boilers

# Demo-only: comma-separated usernames that skip the device-setup gate (app/layout.js).
# Leave unset in a real deploy.
# DEMO_USERS=

# Cloudflare R2 (S3-compatible) — Test Certificate PDF storage (lib/r2.js). Leave unset and the
# upload/AI-populate flow degrades gracefully: certificates still save, just without a stored PDF.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_DOMAIN_URL=

# OpenRouter — AI field extraction from an uploaded certificate PDF (lib/extract.js). Leave unset
# and the upload still works; fields just aren't auto-populated (fill in by hand instead).
OPENROUTER_API_KEY=
EXTRACTION_MODEL=google/gemini-2.5-flash

PORT=3000
