{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sb-ops-boiler-erp-demo",
  "account_id": "5d8cf246f656006b81d99d734e8c0f40",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-27",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"], // public fetch: lib/demo-leads.js calls ahromlabs.com (same zone)
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "routes": [{ "pattern": "boiler-erp.ahromlabs.com", "custom_domain": true }],
  // Secrets (wrangler secret put): TURSO_URL, TURSO_AUTH_TOKEN, SESSION_SECRET, SECRETS_KEY,
  // LEADS_TURSO_URL, LEADS_TURSO_AUTH_TOKEN, CUSTOMER_SEED. Never the live deployment's values.
  "vars": { "DEMO_MODE": "1", "SKIP_MIGRATE": "1", "APP_URL": "https://boiler-erp.ahromlabs.com",
    // The owner pass reads and writes golden instead, so its changes survive the nightly reset (lib/db.js).
    "GOLDEN_TURSO_URL": "libsql://sb-demo-golden-pujan.aws-ap-south-1.turso.io" },
  // Run next to the database (Turso, Mumbai): a page makes many sequential queries.
  "placement": { "mode": "smart" },
  // Demo file uploads (owner pass only, lib/r2.js); the client deployment uses its own R2 keys instead.
  "r2_buckets": [{ "binding": "DEMO_FILES", "bucket_name": "sb-demo-files" }],
  "observability": { "enabled": true }
}
